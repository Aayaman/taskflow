# Copy to .env and fill in the passwords. Never commit .env.
# Format rules (read by both Docker Compose and Spring):
#   KEY=value  - no quotes, no spaces around '=', no 'export'
# Generate passwords with: openssl rand -hex 24
# Store them in Bitwarden before pasting them here.

POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
